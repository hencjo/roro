#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
fail() { printf 'package: %s\n' "$*" >&2; exit 1; }
[[ $# == 1 ]] || fail 'usage: scripts/package roro-v<VERSION>'
tag=$1
./scripts/release --verify-tag "$tag"
[[ -z $(git status --porcelain --untracked-files=all) ]] || fail 'working tree must be clean, including untracked files'
[[ $(uname -s) == Linux ]] || fail 'packaging supports Linux hosts only'
arch=$(uname -m)
[[ $arch == x86_64 || $arch == aarch64 ]] || fail 'supported hosts: x86_64 and aarch64 Linux'
for tool in cargo nix file readelf tar sha256sum python3; do command -v "$tool" >/dev/null || fail "$tool is required; enter devenv shell"; done
version=${tag#roro-v}
package="roro-${version}-linux-${arch}-static"
source="roro-${version}-source.tar.gz"
mkdir -p dist
# Validate the stamped source, then let the pinned Nix flake build musl locally.
./scripts/check-release
nix build .#static --no-update-lock-file --out-link dist/build
./scripts/release --verify-tag "$tag"
[[ -z $(git status --porcelain --untracked-files=all) ]] || fail 'build changed source or lockfiles; refusing to package dirty source'
binary=dist/build/bin/roro
[[ $("$binary" --version) == "roro $version" ]] || fail 'built binary version differs from release tag'
file --brief "$binary" | grep -Eq 'statically linked|static-pie linked' || fail 'release binary is not static'
./scripts/check-static "$binary"
work=$(mktemp -d "$root/dist/.package.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir "$work/$package"
cp "$binary" README.md CONTRIBUTING.md LICENSE SECURITY.md CHANGELOG.md config.example.yaml "$work/$package/"
cp -R docs "$work/$package/"
mkdir "$work/$package/scripts"
cp scripts/ci-smoke.sh "$work/$package/scripts/"
git archive --format=tar.gz --prefix="roro-${version}/" "$tag" > "$work/$source"
python3 -B scripts/licenses "$work/$package"
python3 - "$work/$package/release.json" "$tag" "$version" "$arch" "$(git rev-parse HEAD)" "$work/$source" <<'PYTHON'
import hashlib,json,sys
from pathlib import Path
output,tag,version,arch,commit,source=sys.argv[1:]
with open(source,'rb') as f: digest=hashlib.file_digest(f,'sha256').hexdigest()
Path(output).write_text(json.dumps({'schemaVersion':1,'project':'roro','version':version,'tag':tag,'commit':commit,'system':f'{arch}-linux','target':f'{arch}-unknown-linux-musl','sourceArchive':Path(source).name,'sourceSha256':digest},indent=2)+'\n')
PYTHON
tar --owner=0 --group=0 --numeric-owner -C "$work" -czf "$work/$package.tar.gz" "$package"
(cd "$work" && sha256sum "$package.tar.gz" > "$package.tar.gz.sha256" && sha256sum "$source" > "$source.sha256")
# Do not publish a partially built archive or checksum into dist.
mv "$work/$package.tar.gz" "$work/$package.tar.gz.sha256" "$work/$source" "$work/$source.sha256" dist/
python3 -B scripts/check-package "$tag" "$arch"
printf 'Built: dist/%s.tar.gz\nChecksum: dist/%s.tar.gz.sha256\n' "$package" "$package"
