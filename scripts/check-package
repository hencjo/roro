#!/usr/bin/env python3
"""Verify a local release's checksums, source tree, provenance, and static ELF."""
import hashlib
import json
from pathlib import Path, PurePosixPath
import subprocess
import sys
import tarfile
import tempfile


def require(condition, message):
    if not condition:
        raise ValueError(message)


def git(*args):
    return subprocess.check_output(["git", *args]).decode().strip()


def sha(path):
    with path.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def checked_tar(path):
    require(path.is_file(), f"Missing {path.name}")
    require(path.with_name(path.name + ".sha256").read_text() == f"{sha(path)}  {path.name}\n", f"Checksum mismatch: {path.name}")
    archive = tarfile.open(path, "r:gz")
    seen = set()
    for member in archive.getmembers():
        parts = PurePosixPath(member.name)
        require(not parts.is_absolute() and ".." not in parts.parts, "Unsafe archive path")
        require(member.name not in seen, "Duplicate archive entry")
        require(member.isfile() or member.isdir(), "Only regular files/directories allowed in binary packages")
        seen.add(member.name)
    return archive


def main():
    tag, arch = sys.argv[1:]
    require(tag.startswith("roro-v"), "Expected roro-vVERSION")
    version = tag.removeprefix("roro-v")
    require(arch in {"x86_64", "aarch64"}, "Unsupported package architecture")
    commit = git("rev-parse", tag + "^{commit}")
    require(commit == git("rev-parse", "HEAD"), "Checkout differs from release")
    prefix = f"roro-{version}-linux-{arch}-static"
    path = Path("dist") / (prefix + ".tar.gz")
    source = Path("dist") / f"roro-{version}-source.tar.gz"
    with checked_tar(path) as archive:
        require(all(m.name == prefix or m.name.startswith(prefix + "/")
                    for m in archive.getmembers()), "Unexpected binary archive prefix")
        meta = json.load(archive.extractfile(prefix + "/release.json"))
        require(meta == {"schemaVersion": 1, "project": "roro", "version": version, "tag": tag,
                         "commit": commit, "system": f"{arch}-linux", "target": f"{arch}-unknown-linux-musl",
                         "sourceArchive": source.name, "sourceSha256": sha(source)}, "Package provenance mismatch")
        require(archive.extractfile(prefix + "/THIRD_PARTY_NOTICES.md") is not None, "Missing dependency notices")
        with tempfile.TemporaryDirectory(prefix="roro-elf-") as tmp:
            binary = Path(tmp) / "roro"
            binary.write_bytes(archive.extractfile(prefix + "/roro").read())
            subprocess.run(["bash", "scripts/check-static", binary], check=True)
            header = subprocess.check_output(["readelf", "--wide", "--file-header", "--", binary]).decode()
            require(("X86-64" if arch == "x86_64" else "AArch64") in header, "ELF architecture mismatch")
    # Check source contents against the tag, not merely a self-reported checksum.
    with checked_tar(source) as archive:
        expected = {}
        for raw in subprocess.check_output(["git", "ls-tree", "-r", "-z", commit]).split(b"\0"):
            if raw:
                description, name = raw.split(b"\t", 1)
                mode, kind, oid = description.decode().split()
                require(kind == "blob" and mode in {"100644", "100755"}, "Unsupported source entry")
                expected[f"roro-{version}/" + name.decode()] = (mode, oid)
        actual = {m.name: m for m in archive.getmembers() if m.isfile()}
        require(actual.keys() == expected.keys(), "Source archive file set differs from tag")
        for name, (mode, oid) in expected.items():
            require(bool(actual[name].mode & 0o111) == (mode == "100755"), "Source executable mode differs from tag")
            data = archive.extractfile(actual[name]).read()
            require(data == subprocess.check_output(["git", "cat-file", "blob", oid]), "Source archive differs from tag")
    print(f"Verified package, provenance, exact source, and static ELF: {path}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.CalledProcessError) as error:
        print(f"package check: {error}", file=sys.stderr)
        raise SystemExit(1)
