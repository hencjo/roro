#!/usr/bin/env python3
"""Scan all local Git refs and publishable working files; never print secrets."""
import os
import hashlib
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]


def main():
    os.chdir(ROOT)
    # A path exemption must not conceal a replacement real key, including in history.
    fixture = "tests/fixtures/ci-test-private.pem"
    expected = "09dfc1806fdedc9ce1c24fb2c0ae2483f948dcd11272b10a65d9d306d499622f"
    if hashlib.sha256((ROOT / fixture).read_bytes()).hexdigest() != expected:
        raise RuntimeError("Public fixture key changed; review it before changing the scanner exemption")
    objects = subprocess.check_output(["git", "rev-list", "--objects", "--all", "--", fixture]).splitlines()
    for line in objects:
        fields = line.split(b" ", 1)
        if len(fields) == 2 and fields[1].decode() == fixture:
            content = subprocess.check_output(["git", "cat-file", "blob", fields[0].decode()])
            if hashlib.sha256(content).hexdigest() != expected:
                raise RuntimeError("Unexpected historical key in the exempted fixture path")
    common = ["--redact=100", "--no-banner", "--config", str(ROOT / ".gitleaks.toml")]
    history = subprocess.run(["gitleaks", "git", *common, "--log-opts=--all", "."])
    staged = subprocess.run(["gitleaks", "git", *common, "--staged", "."])
    paths = subprocess.check_output([
        "git", "ls-files", "-z", "--cached", "--others", "--exclude-standard",
    ]).split(b"\0")
    with tempfile.TemporaryDirectory(prefix="roro-secrets-") as directory:
        for raw in set(paths) - {b""}:
            relative = Path(os.fsdecode(raw))
            source = ROOT / relative
            target = Path(directory) / relative
            if source.is_symlink():
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(os.readlink(source))
            elif source.is_file():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, target)
            elif source.exists():
                raise RuntimeError(f"Unsupported entry (submodule?): {relative}")
            # Locally deleted tracked files remain covered by the history scan.
        worktree = subprocess.run(["gitleaks", "dir", *common, directory])
    return history.returncode or staged.returncode or worktree.returncode


if __name__ == "__main__":
    raise SystemExit(main())
